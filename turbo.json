{
  "$schema": "https://v2-11-4.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:ci": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"]
    },
    "test:smoke": {
      "dependsOn": ["^build"]
    },
    "test:browser": {
      "dependsOn": ["^build"]
    },
    "test:types": {
      "dependsOn": ["^build"]
    },
    "test:performance": {
      "dependsOn": ["^build"]
    },
    "coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "circular": {
      "dependsOn": ["^build"]
    },
    "knip": {},
    "publint": {
      "dependsOn": ["build"]
    },
    "analyze": {
      "dependsOn": ["^build"]
    },
    "analyze:circular": {
      "dependsOn": ["^build"]
    },
    "analyze:deps": {
      "dependsOn": ["^build"]
    },
    "security:licenses": {}
  }
}
