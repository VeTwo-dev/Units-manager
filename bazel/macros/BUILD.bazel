"""Package marker and platform aliases for the Bazel macro library.

Keeps `bazel/macros/*.bzl` resolvable as `//bazel/macros:<file>.bzl`, and hosts
the `node` alias that selects the hermetic Node.js runtime for the exec
platform.

Why the alias exists: rules_nodejs registers one `@nodejs_<platform>` repo per
platform (see `external/rules_nodejs++node+nodejs_toolchains/BUILD.bazel`), so a
macro that needs the node binary must not hardcode a single repo. Referencing
`//bazel/macros:node` resolves to the correct binary for the host platform,
which is what the generated harnesses execute.
"""

config_setting(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "linux_s390x",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:s390x",
    ],
)

config_setting(
    name = "linux_ppc64le",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:ppc",
    ],
)

config_setting(
    name = "darwin_amd64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "windows_amd64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

# Hermetic Node.js binary for the platform the harness runs on.
alias(
    name = "node",
    actual = select({
        ":linux_amd64": "@@rules_nodejs++node+nodejs_linux_amd64//:bin/node",
        ":linux_arm64": "@@rules_nodejs++node+nodejs_linux_arm64//:bin/node",
        ":linux_s390x": "@@rules_nodejs++node+nodejs_linux_s390x//:bin/node",
        ":linux_ppc64le": "@@rules_nodejs++node+nodejs_linux_ppc64le//:bin/node",
        ":darwin_amd64": "@@rules_nodejs++node+nodejs_darwin_amd64//:bin/node",
        ":darwin_arm64": "@@rules_nodejs++node+nodejs_darwin_arm64//:bin/node",
        ":windows_amd64": "@@rules_nodejs++node+nodejs_windows_amd64//:bin/node",
        "//conditions:default": "@@rules_nodejs++node+nodejs_linux_amd64//:bin/node",
    }),
    visibility = ["//visibility:public"],
)