{
  "name": "units-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.21.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "coverage": "turbo run coverage",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration",
    "test:unit": "turbo run test:unit",
    "circular": "turbo run circular",
    "knip": "knip",
    "publint": "npx publint",
    "check": "turbo run check-types lint test",
    "ci": "pnpm run verify:full && bun run security:licenses && pnpm run circular && bun run analyze",
    "verify": "turbo run lint check-types test build",
    "verify:full": "pnpm run verify && pnpm run knip && pnpm run publint && bun run format",
    "publish": "npm publish --access public",
    "analyze": "turbo run analyze",
    "analyze:circular": "turbo run analyze:circular",
    "analyze:deps": "turbo run analyze:deps",
    "deps": "pnpm -r list --depth 0",
    "deps:check": "pnpm -r list --depth 0 && pnpm -r outdated",
    "deps:dedupe": "pnpm dedupe",
    "deps:list": "pnpm -r list",
    "deps:outdated": "pnpm -r outdated",
    "deps:update": "pnpm -r update",
    "deps:why": "pnpm why",
    "security": "pnpm run security:licenses",
    "security:ci": "pnpm run security:licenses",
    "security:licenses": "turbo run security:licenses",
    "test:browser": "turbo run test:browser",
    "test:ci": "turbo run test:ci",
    "test:debug": "pnpm -r run test:debug",
    "test:performance": "turbo run test:performance",
    "test:smoke": "turbo run test:smoke",
    "sync-workspace": "pnpm exec tsx scripts/sync-workspace.ts",
    "verify:publint": "npx publint",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "verify:changesets": "changeset status",
    "verify:manypkg": "npx manypkg check",
    "validate": "npx manypkg check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.12.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^9.1.0",
    "knip": "^6.37.0",
    "madge": "^6.1.0",
    "prettier": "^3.9.8",
    "publint": "^0.3.24",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript-eslint": "^8.8.0"
  }
}
