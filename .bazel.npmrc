# Bazel-specific npm registry configuration.
#
# The user's root .npmrc points at a local verdaccio (http://localhost:4873/),
# which is a developer convenience and is not available in all environments
# (CI, fresh clones). Bazel's npm_translate_lock reads this file instead and
# fetches the same packages — verified by the pnpm-lock.yaml integrity hashes —
# from the public npm registry.
#
# This file is Bazel-owned. The user's .npmrc is not modified. To make Bazel use
# the local registry instead, point `npmrc` in MODULE.bazel at //:.npmrc and run
# the local registry.

registry=https://registry.npmjs.org/
