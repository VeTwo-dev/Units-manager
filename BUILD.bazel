# Bazel build for Packages/Units manager (workspace root).
#
# Workspace root aggregating packages/Nutrition-units, packages/Units, and
# apps/nutrition-units-example. Package marker only — sub-packages have their
# own BUILD files.

load("@npm//:defs.bzl", "npm_link_all_packages")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")

npm_link_all_packages()

filegroup(
    name = "package",
    srcs = ["package.json"],
    visibility = ["//visibility:public"],
)

npm_package(
    name = "pkg",
    srcs = [":package"],
    package = "units-monorepo",
    version = "0.0.0",
    visibility = ["//visibility:public"],
)
